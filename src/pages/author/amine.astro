---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE, CATEGORIES, type CategoryId } from "../../config";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const order: CategoryId[] = ["skills", "patterns", "charts", "gear"];
const groups = order
  .map((id) => ({ id, label: CATEGORIES[id].label, posts: posts.filter((p) => p.data.category === id) }))
  .filter((group) => group.posts.length > 0);

const pageUrl = new URL(SITE.author.url, SITE.url).href;
const schema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: pageUrl,
  mainEntity: {
    "@type": "Person",
    name: SITE.author.name,
    jobTitle: SITE.author.role,
    description: SITE.author.bio,
    url: pageUrl,
    worksFor: { "@type": "Organization", name: SITE.name, url: SITE.url },
  },
};
---

<BaseLayout
  title={`${SITE.author.name}, publisher and editor`}
  description={`${SITE.author.name} publishes ${SITE.name}, a beginner-friendly site of practical crochet lessons and patterns.`}
  schema={schema}
>
  <div class="mx-auto max-w-3xl px-6 py-10 sm:px-8 sm:py-14">
    <div class="flex items-center gap-5">
      <div
        aria-hidden="true"
        class="flex h-20 w-20 shrink-0 items-center justify-center rounded-full border border-rule bg-paper-deep font-serif text-2xl text-terracotta-deep"
      >
        MA
      </div>
      <div>
        <h1 class="font-serif text-3xl tracking-tight sm:text-4xl">{SITE.author.name}</h1>
        <p class="mt-1 text-ink-soft">{SITE.author.role}, {SITE.name}</p>
      </div>
    </div>

    <div class="prose mt-8">
      <p>{SITE.author.bio}</p>
      <p>
        {SITE.author.name} is not a crochet designer and does not hold a
        teaching credential. Pattern sizes are calculations from the gauge on
        the page, and pictures of finished objects are illustrations, not
        photographs of a made sample. Details are on the
        <a href="/disclosures/">disclosures page</a>. If a count looks wrong,
        use the <a href="/contact/">contact page</a> and name the page and the
        row.
      </p>
    </div>

    <section class="mt-12 border-t border-rule pt-8">
      <h2 class="font-serif text-2xl tracking-tight">Published pages</h2>
      <p class="mt-2 text-sm text-ink-soft">{posts.length} published articles.</p>
      {
        groups.map((group) => (
          <div class="mt-6">
            <h3 class="text-xs font-semibold tracking-wider text-ink-faint uppercase">
              {group.label} ({group.posts.length})
            </h3>
            <ul class="mt-2 space-y-1.5 text-sm">
              {group.posts.map((post) => (
                <li>
                  <a href={`/${post.id}/`} class="text-ink no-underline hover:text-terracotta-deep hover:underline">
                    {post.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>
  </div>
</BaseLayout>
