---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE, SOCIALS } from "../config";

/**
 * SITE.email is intentionally empty until a real inbox exists. While it is,
 * this page routes people to social instead of showing a dead address.
 */
const hasEmail = SITE.email.length > 0;

const schema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: `Contact ${SITE.name}`,
  mainEntity: {
    "@type": "Organization",
    name: SITE.name,
    ...(hasEmail && { email: SITE.email }),
    sameAs: SOCIALS.map((social) => social.url),
  },
};
---

<BaseLayout
  title="Contact"
  description={`Get in touch with ${SITE.name} about corrections, pattern features, or partnerships.`}
  schema={schema}
>
  <div class="mx-auto max-w-2xl px-5 py-10 sm:py-14">
    <h1 class="font-serif text-3xl tracking-tight sm:text-4xl">Contact</h1>

    <div class="prose mt-8">
      {
        hasEmail ? (
          <>
            <p>
              The fastest way to reach me is email, and it comes to me directly
              rather than to a support queue.
            </p>
            <p>
              <a href={`mailto:${SITE.email}`} class="text-lg font-semibold">
                {SITE.email}
              </a>
            </p>
          </>
        ) : (
          <>
            <p>
              The quickest way to reach me right now is a direct message on any
              of the accounts below. They all reach the same person.
            </p>
            <ul>
              {SOCIALS.map((social) => (
                <li>
                  <a href={social.url} rel="me noopener">
                    {social.name}
                  </a>
                </li>
              ))}
            </ul>
          </>
        )
      }

      <h2>What gets a fast reply</h2>
      <ul>
        <li>
          <strong>A correction.</strong> If a chart or a tutorial step is wrong,
          tell me which page and what you found. These go to the front of the
          queue and the page gets fixed.
        </li>
        <li>
          <strong>A designer asking about a feature.</strong> If your pattern
          appears in one of the round-ups and you would like the credit adjusted
          or the link removed entirely, say so and it will be done. No argument,
          no delay.
        </li>
        <li>
          <strong>A question you could not find the answer to.</strong> These
          often turn into new articles, and it is the most useful thing you can
          send me.
        </li>
      </ul>

      <h2>What will not get a reply</h2>
      <ul>
        <li>Guest post pitches and paid link requests.</li>
        <li>Offers to insert links into existing articles.</li>
        <li>Anything sent to a hundred blogs at once.</li>
      </ul>

      {
        !hasEmail && (
          <div class="warning">
            <p>
              <strong>Note for the site owner:</strong> AdSense requires a working
              way for readers to reach you. Set up a real inbox, put the address
              in <code>SITE.email</code> in <code>src/config.ts</code>, and this
              page will switch to showing it automatically. Do that before you
              apply.
            </p>
          </div>
        )
      }
    </div>
  </div>
</BaseLayout>
