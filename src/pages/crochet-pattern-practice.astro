---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Crochet Pattern Practice"
  description="Five questions on US abbreviations, repeats, and stitch counts, with the reason after each answer."
>
  <article class="mx-auto max-w-3xl px-6 py-12 sm:px-8 sm:py-16">
    <p class="text-xs font-semibold tracking-wider text-terracotta-deep uppercase">Charts and tools</p>
    <h1 class="mt-3 font-serif text-3xl tracking-tight sm:text-4xl">Pattern practice</h1>
    <p class="mt-4 leading-relaxed text-ink-soft">
      US terms. These questions use the same counts as the <a class="text-terracotta-deep underline" href="/how-to-read-a-crochet-pattern/">pattern-reading lesson</a>. A different pattern can count its turning chain differently.
    </p>
    <form id="quiz" class="mt-8 space-y-8"></form>
    <p id="quiz-score" class="mt-6 font-medium" aria-live="polite"></p>
  </article>
</BaseLayout>

<script>
  import { explainAnswer, PATTERN_QUESTIONS, scoreQuiz } from "../lib/patternQuiz";

  const questions = PATTERN_QUESTIONS;

  const form = document.querySelector<HTMLFormElement>("#quiz");
  const score = document.querySelector<HTMLElement>("#quiz-score");
  if (form) {
    questions.forEach((question, index) => {
      const field = document.createElement("fieldset");
      field.className = "rounded-lg border border-rule p-4";
      const legend = document.createElement("legend");
      legend.className = "px-1 font-medium";
      legend.textContent = `${index + 1}. ${question.prompt}`;
      field.append(legend);
      question.options.forEach((option, optionIndex) => {
        const id = `q${index}-${optionIndex}`;
        const label = document.createElement("label");
        label.className = "mt-3 flex min-h-11 items-center gap-3";
        label.setAttribute("for", id);
        const input = document.createElement("input");
        input.type = "radio";
        input.name = `q${index}`;
        input.id = id;
        input.value = String(optionIndex);
        const text = document.createElement("span");
        text.textContent = option;
        label.append(input, text);
        field.append(label);
      });
      const check = document.createElement("button");
      check.type = "button";
      check.className = "mt-4 min-h-11 rounded border border-rule bg-paper px-3 py-2";
      check.textContent = "Check this question";
      const note = document.createElement("p");
      note.className = "mt-3 text-sm leading-relaxed";
      note.setAttribute("aria-live", "polite");
      check.addEventListener("click", () => {
        const chosen = field.querySelector<HTMLInputElement>("input:checked");
        if (!chosen) {
          note.textContent = "Choose an answer first.";
          return;
        }
        note.textContent = explainAnswer(question, Number(chosen.value));
      });
      field.append(check, note);
      form.append(field);
    });
  }

  const finish = document.createElement("button");
  finish.type = "button";
  finish.className = "min-h-11 rounded bg-terracotta px-4 py-2 text-paper";
  finish.textContent = "Score all five";
  finish.addEventListener("click", () => {
    if (!form || !score) return;
    const answers = questions.map((_, index) => {
      const chosen = form.querySelector<HTMLInputElement>(`input[name="q${index}"]:checked`);
      return chosen ? Number(chosen.value) : null;
    });
    score.textContent = scoreQuiz(answers).text;
  });
  form?.append(finish);
</script>
