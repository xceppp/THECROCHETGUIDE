---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config";

const effective = "October 7, 2026";
---

<BaseLayout
  title="Privacy Policy"
  description={`Choose the privacy and cookie notice that matches your region: EU/UK or United States.`}
>
  <div class="mx-auto max-w-3xl px-6 sm:px-8 py-10 sm:py-14">
    <h1 class="font-serif text-3xl tracking-tight sm:text-4xl">
      Privacy Policy
    </h1>
    <p class="mt-3 text-sm text-ink-faint">Last updated {effective}</p>

    <div class="prose mt-8">
      <p>
        {SITE.name} ({SITE.url}) publishes different privacy and cookie notices
        for Europe and for the United States, because the rules are not the same.
        Pick the page that matches where you are.
      </p>

      <div class="not-prose mt-8 grid gap-4 sm:grid-cols-2">
        <a
          href="/privacy-eu"
          class="rounded-lg border border-rule bg-paper-deep px-5 py-5 no-underline transition-colors hover:border-terracotta"
        >
          <span class="block font-serif text-xl text-ink">EU / UK / EEA</span>
          <span class="mt-2 block text-sm leading-relaxed text-ink-soft">
            GDPR and ePrivacy. Optional cookies (analytics and ads) load only
            after you accept.
          </span>
        </a>
        <a
          href="/privacy-us"
          class="rounded-lg border border-rule bg-paper-deep px-5 py-5 no-underline transition-colors hover:border-terracotta"
        >
          <span class="block font-serif text-xl text-ink">United States</span>
          <span class="mt-2 block text-sm leading-relaxed text-ink-soft">
            Including California CCPA/CPRA. Notice, opt-out of sale/sharing for
            personalized ads, and your request rights.
          </span>
        </a>
      </div>

      <h2>Cookie settings</h2>
      <p>
        Change or withdraw your choice at any time on the
        <a href="/cookie-settings">cookie settings</a> page. Course progress stays
        on your device only and does not need consent.
      </p>

      <h2>Terms of use</h2>
      <p>
        Site rules for using the tutorials and charts are in the
        <a href="/terms">Terms of Use</a> (same for all visitors). Money and AI
        image notes are on <a href="/disclosures">Disclosures</a>.
      </p>

      <div class="warning">
        <p>
          <strong>Note for the site owner:</strong> these pages are a practical
          starting point for AdSense and a US/EU audience. They are not legal
          advice. Have a lawyer review them before you rely on them in a dispute.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
