---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import AdSlot from "../components/AdSlot.astro";
import ArticleIndex from "../components/ArticleIndex.astro";
import { getPathStages } from "../lib/learningPath";
import { ARTICLE_PAGE_SIZE } from "../lib/articlePages";
import { SITE, CATEGORIES } from "../config";
import { resolveSeasonalOccasion } from "../lib/seasonalTheme";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const pinned = posts.find((post) => post.data.pinned) ?? null;
const unpinned = pinned ? posts.filter((post) => post.id !== pinned.id) : posts;

const occasion = resolveSeasonalOccasion();
const seasonalTag = occasion?.contentTag?.toLowerCase();
const seasonalPosts = seasonalTag
  ? unpinned
      .filter((post) =>
        post.data.tags.some((tag) => tag.toLowerCase() === seasonalTag),
      )
      .sort((a, b) => Number(b.data.featured) - Number(a.data.featured))
  : [];

// Featured seasonal piece is pinned first on the homepage when the season is live.
const featuredSeasonal = seasonalPosts[0] ?? null;
const archiveLast = Math.max(1, Math.ceil(posts.length / ARTICLE_PAGE_SIZE));
const archivePosts = posts.slice(0, ARTICLE_PAGE_SIZE);

// Phone screens were opening on a single lead card. Four compact cards
// sit above the fold instead; wider screens keep the lead treatment.
const topMobile = [
  ...(pinned ? [pinned] : []),
  ...seasonalPosts,
  ...posts,
]
  .filter((post, index, list) => list.findIndex((item) => item.id === post.id) === index)
  .slice(0, 4);
const topMobileIds = new Set(topMobile.map((post) => post.id));
const otherSeasonal = featuredSeasonal
  ? seasonalPosts.filter((post) => post.id !== featuredSeasonal.id)
  : seasonalPosts;
const seasonalOnMobile = otherSeasonal
  .slice(0, 4)
  .filter((post) => !topMobileIds.has(post.id));

const stages = await getPathStages();
const totalSteps = stages.reduce((sum, stage) => sum + stage.steps.length, 0);

const seasonalHeading =
  seasonalTag === "halloween"
    ? "Halloween projects"
    : seasonalTag === "christmas"
      ? "Christmas projects"
      : "";
---

<BaseLayout
  title="Crochet Explained: Beginner Crochet Tutorials, Charts & Free Patterns"
  description={SITE.description}
>
  <h1 class="sr-only">{SITE.name}</h1>
  {
    topMobile.length > 0 && (
      <section class="border-b border-rule sm:hidden">
        <div class="mx-auto max-w-4xl px-4 py-5">
          <h2 class="text-xs font-semibold tracking-wider text-ink-faint uppercase">
            Tutorials
          </h2>
          <div class="mt-3 grid grid-cols-2 gap-x-3 gap-y-5">
            {topMobile.map((post, index) => (
              <PostCard post={post} compact eager={index === 0} />
            ))}
          </div>
        </div>
      </section>
    )
  }
  {
    pinned && (
      <section class="hidden border-b border-rule sm:block">
        <div class="mx-auto max-w-4xl px-6 py-12 sm:px-8">
          <h2 class="text-xs font-semibold tracking-wider text-ink-faint uppercase">
            Pinned
          </h2>
          <div class="mt-5">
            <PostCard post={pinned} lead />
          </div>
        </div>
      </section>
    )
  }

  {
    posts.length > 0 && (
      <section class="border-b border-rule">
        <div class="mx-auto max-w-4xl px-4 py-8 sm:px-8 sm:py-12">
          <ArticleIndex
            posts={archivePosts}
            current={1}
            last={archiveLast}
            heading="All articles"
          />
        </div>
      </section>
    )
  }

  <hr class="season-divider mx-auto max-w-4xl" aria-hidden="true" />

  {
    seasonalPosts.length > 0 && (
      <section
        class:list={[
          "border-b border-rule",
          seasonalOnMobile.length === 0 && "hidden sm:block",
        ]}
      >
        <div class="mx-auto max-w-4xl px-6 py-12 sm:px-8">
          <h2 class="font-serif text-2xl tracking-tight">{seasonalHeading}</h2>
          <p class="mt-2 leading-relaxed text-ink-soft">
            Seasonal tutorials for the current window. Same plain-English voice
            as the rest of the site.
          </p>
          {
            featuredSeasonal && (
              <div class="mt-6 hidden sm:block">
                <PostCard post={featuredSeasonal} lead />
              </div>
            )
          }
          {
            otherSeasonal.length > 0 && (
              <div class="mt-8 space-y-8 divide-y divide-rule [&>*:not(:first-child)]:pt-8">
                {otherSeasonal.slice(0, 4).map((post) => (
                  <div class:list={[topMobileIds.has(post.id) && "hidden sm:block"]}>
                    <PostCard post={post} />
                  </div>
                ))}
              </div>
            )
          }
        </div>
      </section>
    )
  }

  {
    stages.length > 0 && (
      <section class="border-b border-rule">
        <div class="mx-auto max-w-4xl px-6 py-12 sm:px-8">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 class="font-serif text-2xl tracking-tight">
              The course, start to finish
            </h2>
            <a
              href="/start-here/"
              class="text-sm text-terracotta-deep no-underline hover:underline"
            >
              See all {totalSteps} steps
            </a>
          </div>
          <p class="mt-2 leading-relaxed text-ink-soft">
            Six stages, in teaching order. Each page ends with a link to the next
            one, so you never have to work out what to read after this.
          </p>

          <ol class="mt-6 divide-y divide-rule border-y border-rule">
            {stages.map((stage, index) => (
              <li>
                <a
                  href={`/${stage.steps[0].post.id}/`}
                  class="group flex items-baseline gap-4 py-3.5 no-underline"
                >
                  <span
                    class="font-serif text-sm text-ink-faint"
                    aria-hidden="true"
                  >
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="font-medium text-ink group-hover:text-terracotta-deep">
                      {stage.stage}
                    </span>
                  </span>
                  <span class="shrink-0 text-xs text-ink-faint">
                    {`${stage.steps.length} ${stage.steps.length === 1 ? "step" : "steps"}`}
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  <hr class="season-divider mx-auto max-w-4xl" aria-hidden="true" />

  <div class="mx-auto max-w-4xl px-6 py-12 sm:px-8">
    <h2 class="font-serif text-2xl tracking-tight">Browse by topic</h2>
    <p class="mt-2 leading-relaxed text-ink-soft">
      Charts when you need a number. Tutorials when you need a technique. Gear
      when you need to buy something once.
    </p>

    <div class="mt-6 grid gap-3 sm:grid-cols-2">
      {
        Object.values(CATEGORIES).map((category) => (
          <a
            href={`/${category.slug}/`}
            class="rounded-lg border border-rule bg-paper px-5 py-4 no-underline transition-colors hover:border-terracotta"
          >
            <span class="block font-medium text-ink">{category.label}</span>
            <span class="mt-1 block text-sm leading-relaxed text-ink-soft">
              {category.blurb}
            </span>
          </a>
        ))
      }
    </div>

    <AdSlot placement="footer" />
  </div>
</BaseLayout>
