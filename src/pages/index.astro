---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import AdSlot from "../components/AdSlot.astro";
import ArticleIndex from "../components/ArticleIndex.astro";
import { getPathStages } from "../lib/learningPath";
import { ARTICLE_PAGE_SIZE } from "../lib/articlePages";
import { SITE, CATEGORIES } from "../config";
import { resolveSeasonalOccasion } from "../lib/seasonalTheme";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const byId = new Map(posts.map((post) => [post.id, post]));

const occasion = resolveSeasonalOccasion();
const seasonalTag = occasion?.contentTag?.toLowerCase();
const seasonalPosts = seasonalTag
  ? posts
      .filter((post) =>
        post.data.tags.some((tag) => tag.toLowerCase() === seasonalTag),
      )
      .sort((a, b) => Number(b.data.featured) - Number(a.data.featured))
  : [];

const archiveLast = Math.max(1, Math.ceil(posts.length / ARTICLE_PAGE_SIZE));
const archivePosts = posts.slice(0, ARTICLE_PAGE_SIZE);

const stages = await getPathStages();
const totalSteps = stages.reduce((sum, stage) => sum + stage.steps.length, 0);
const coursePosts = stages.flatMap((stage) => stage.steps.map((step) => step.post));

const chartSlugs = [
  "crochet-abbreviations-chart",
  "crochet-hook-size-conversion-chart",
  "yarn-weight-chart",
];
const charts = chartSlugs
  .map((slug) => byId.get(slug))
  .filter((post) => post != null);

/**
 * Distinct written guides. Several say on the page that they have not been
 * made in yarn. They are listed after the course, not as proven samples.
 */
const practicalSlugs = [
  "how-to-crochet-a-beginner-scarf",
  "crochet-mug-cozy-for-beginners",
  "how-to-crochet-a-pumpkin-step-by-step",
  "crochet-ghost-amigurumi-for-beginners",
  "how-to-crochet-a-spider-and-web",
  "how-to-crochet-a-simple-flower",
];
const practical = practicalSlugs
  .map((slug) => byId.get(slug))
  .filter((post) => post != null);

const seasonalHeading =
  seasonalTag === "halloween"
    ? "Halloween ideas"
    : seasonalTag === "christmas"
      ? "Christmas ideas"
      : occasion
        ? `${occasion.name}`
        : "";
---

<BaseLayout
  title="Crochet Explained: Beginner Crochet Tutorials, Charts & Free Patterns"
  description={SITE.description}
>
  <section class="border-b border-rule bg-paper-deep">
    <div class="mx-auto max-w-4xl px-6 py-14 sm:px-8 sm:py-20">
      <p class="text-xs font-semibold tracking-wider text-terracotta-deep uppercase">
        {SITE.name}
      </p>
      <h1 class="mt-3 max-w-2xl font-serif text-4xl leading-tight tracking-tight sm:text-5xl">
        Learn crochet with clear, step-by-step guides
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-soft">
        Start with the {totalSteps}-step course, keep the charts handy for the
        numbers, and work through clear project guides with step-by-step
        diagrams for the parts beginners get stuck on.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/start-here/"
          class="rounded-full bg-terracotta px-6 py-2.5 font-medium text-paper no-underline transition-colors hover:bg-terracotta-deep"
        >
          Start the {totalSteps}-step course
        </a>
        <a
          href="/crochet-abbreviations-chart/"
          class="rounded-full border border-rule bg-paper px-6 py-2.5 font-medium text-ink-soft no-underline transition-colors hover:border-terracotta hover:text-terracotta-deep"
        >
          Stitch abbreviations
        </a>
      </div>
      <p class="mt-6 text-sm text-ink-soft">
        <a href="/about/" class="text-terracotta-deep no-underline hover:underline">About</a>
        <span aria-hidden="true"> · </span>
        <a href="/disclosures/" class="text-terracotta-deep no-underline hover:underline">Disclosures</a>
      </p>
    </div>
  </section>

  {
    stages.length > 0 && (
      <section class="border-b border-rule">
        <div class="mx-auto max-w-4xl px-6 py-12 sm:px-8">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 class="font-serif text-2xl tracking-tight">
              The course, start to finish
            </h2>
            <a
              href="/start-here/"
              class="text-sm text-terracotta-deep no-underline hover:underline"
            >
              See all {totalSteps} steps
            </a>
          </div>
          <p class="mt-2 leading-relaxed text-ink-soft">
            Six stages, in teaching order. Each page ends with a link to the next
            one, so you never have to work out what to read after this.
          </p>
          <ol class="mt-6 divide-y divide-rule border-y border-rule">
            {stages.map((stage, index) => (
              <li>
                <a
                  href={`/${stage.steps[0].post.id}/`}
                  class="group flex items-baseline gap-4 py-3.5 no-underline"
                >
                  <span class="font-serif text-sm text-ink-faint" aria-hidden="true">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="font-medium text-ink group-hover:text-terracotta-deep">
                      {stage.stage}
                    </span>
                    <span class="mt-0.5 block text-sm text-ink-soft">{stage.blurb}</span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  {
    coursePosts.length > 0 && (
      <section class="border-b border-rule">
        <div class="mx-auto max-w-4xl px-6 py-12 sm:px-8">
          <h2 class="font-serif text-2xl tracking-tight">Beginner techniques</h2>
          <p class="mt-2 leading-relaxed text-ink-soft">
            The course lessons, in order. Read these before a shaped project.
          </p>
          <div class="mt-6 space-y-8 divide-y divide-rule [&>*:not(:first-child)]:pt-8">
            {coursePosts.slice(0, 6).map((post) => (
              <PostCard post={post} />
            ))}
          </div>
          <p class="mt-6 text-sm">
            <a href="/start-here/" class="text-terracotta-deep no-underline hover:underline">
              All {totalSteps} lessons
            </a>
          </p>
        </div>
      </section>
    )
  }

  {
    charts.length > 0 && (
      <section class="border-b border-rule">
        <div class="mx-auto max-w-4xl px-6 py-12 sm:px-8">
          <h2 class="font-serif text-2xl tracking-tight">Stitches, hooks, and yarn</h2>
          <p class="mt-2 leading-relaxed text-ink-soft">
            Lookup pages. Open one when a pattern uses a term or a number you do not know yet.
          </p>
          <div class="mt-6 space-y-8 divide-y divide-rule [&>*:not(:first-child)]:pt-8">
            {charts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="border-b border-rule">
    <div class="mx-auto max-w-4xl px-6 py-12 sm:px-8">
      <h2 class="font-serif text-2xl tracking-tight">Check a number while you work</h2>
      <p class="mt-2 leading-relaxed text-ink-soft">
        Three small tools. The calculator predicts a width from a swatch. It does not measure the piece in your hands.
      </p>
      <ul class="mt-6 space-y-3 text-ink-soft">
        <li>
          <a href="/crochet-gauge-calculator/" class="font-medium text-terracotta-deep no-underline hover:underline">Gauge calculator</a>
          . Compare your stitch count with the pattern and see the predicted width.
        </li>
        <li>
          <a href="/crochet-stitch-counter/" class="font-medium text-terracotta-deep no-underline hover:underline">Stitch counter</a>
          . Add one, take one away, or reset. The number stays in this browser tab.
        </li>
        <li>
          <a href="/crochet-pattern-practice/" class="font-medium text-terracotta-deep no-underline hover:underline">Pattern practice</a>
          . Five questions on US abbreviations, repeats, and stitch counts.
        </li>
      </ul>
    </div>
  </section>

  {
    practical.length > 0 && (
      <section class="border-b border-rule">
        <div class="mx-auto max-w-4xl px-6 py-12 sm:px-8">
          <h2 class="font-serif text-2xl tracking-tight">Written project guides</h2>
          <p class="mt-2 leading-relaxed text-ink-soft">
            Each one walks through the shape step by step. Sizes are worked out from gauge, so swatch and measure as you go.
          </p>
          <div class="mt-6 space-y-8 divide-y divide-rule [&>*:not(:first-child)]:pt-8">
            {practical.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    seasonalPosts.length > 0 && (
      <section class="border-b border-rule">
        <div class="mx-auto max-w-4xl px-6 py-12 sm:px-8">
          <h2 class="font-serif text-2xl tracking-tight">{seasonalHeading}</h2>
          <p class="mt-2 leading-relaxed text-ink-soft">
            Projects and techniques to make for the season.
          </p>
          <div class="mt-6 space-y-8 divide-y divide-rule [&>*:not(:first-child)]:pt-8">
            {seasonalPosts.slice(0, 4).map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    posts.length > 0 && (
      <section class="border-b border-rule">
        <div class="mx-auto max-w-4xl px-4 py-8 sm:px-8 sm:py-12">
          <ArticleIndex
            posts={archivePosts}
            current={1}
            last={archiveLast}
            heading="All articles"
          />
        </div>
      </section>
    )
  }

  <div class="mx-auto max-w-4xl px-6 py-12 sm:px-8">
    <h2 class="font-serif text-2xl tracking-tight">Browse by topic</h2>
    <div class="mt-6 grid gap-3 sm:grid-cols-2">
      {
        Object.values(CATEGORIES).map((category) => (
          <a
            href={`/${category.slug}/`}
            class="rounded-lg border border-rule bg-paper px-5 py-4 no-underline transition-colors hover:border-terracotta"
          >
            <span class="block font-medium text-ink">{category.label}</span>
            <span class="mt-1 block text-sm leading-relaxed text-ink-soft">
              {category.blurb}
            </span>
          </a>
        ))
      }
    </div>
    <p class="mt-6 text-sm text-ink-soft">
      <a href="/about/" class="text-terracotta-deep no-underline hover:underline">How this site is written</a>
      <span aria-hidden="true"> · </span>
      <a href="/disclosures/" class="text-terracotta-deep no-underline hover:underline">Disclosures</a>
      <span aria-hidden="true"> · </span>
      <a href="/contact/" class="text-terracotta-deep no-underline hover:underline">Report an error</a>
    </p>
    <AdSlot placement="footer" />
  </div>
</BaseLayout>
