---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import ResumeCard from "../components/ResumeCard.astro";
import AdSlot from "../components/AdSlot.astro";
import { getPathStages } from "../lib/learningPath";
import { getPostThumbnail } from "../lib/postThumbnails";
import { SITE, CATEGORIES } from "../config";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const byId = new Map(posts.map((post) => [post.id, post]));

/** Only articles that have a real cover image belong in the visual grids. */
const withThumb = (slug: string) => {
  const post = byId.get(slug);
  return post && getPostThumbnail(post.id) ? post : undefined;
};

const stages = await getPathStages();
const totalSteps = stages.reduce((sum, stage) => sum + stage.steps.length, 0);

/**
 * Which set of projects the home page leads with is driven by an explicit
 * editorial calendar, deliberately independent of the site's seasonal skin:
 * the featured picks can switch over without recoloring the whole site.
 *
 *   Halloween picks:  Sep 15 – Oct 31
 *   Christmas picks:  Nov 1  – Dec 25
 *   Evergreen:        the rest of the year
 *
 * The date is read in the site's editorial timezone (US Eastern) so the
 * switch happens on the same calendar day for the US audience regardless of
 * where the build runs.
 */
const EDITORIAL_TZ = "America/New_York";

function editorialMonthDay(now = new Date()): number {
  const parts = new Intl.DateTimeFormat("en-US", {
    timeZone: EDITORIAL_TZ,
    month: "2-digit",
    day: "2-digit",
  }).formatToParts(now);
  const month = Number(parts.find((p) => p.type === "month")?.value ?? "0");
  const day = Number(parts.find((p) => p.type === "day")?.value ?? "0");
  return month * 100 + day;
}

function featuredSeasonTag(now = new Date()): "halloween" | "christmas" | null {
  const md = editorialMonthDay(now);
  if (md >= 915 && md <= 1031) return "halloween";
  if (md >= 1101 && md <= 1225) return "christmas";
  return null;
}

const seasonTag = featuredSeasonTag();

/**
 * Hand-picked seasonal line-ups so the featured grid reads as a varied
 * editorial selection (an amigurumi, a wallet, a motif…) rather than six
 * near-identical cards. Each slug is filtered to ones that actually have a
 * cover image, and evergreen projects fill any gap.
 */
const seasonalSlugs: Record<"halloween" | "christmas", string[]> = {
  halloween: [
    "halloween-crochet-wallets",
    "black-cat-crochet-wallet",
    "ghost-crochet-wallet",
    "pumpkin-crochet-wallet",
    "spiderweb-crochet-wallet",
    "witch-hat-crochet-wallet",
  ],
  christmas: [
    "how-to-crochet-a-snowflake",
    "how-to-crochet-a-christmas-tree",
    "how-to-crochet-a-gnome",
    "crochet-santa-amigurumi-for-beginners",
    "easy-crochet-christmas-ornaments",
    "how-to-crochet-a-christmas-gift-card-holder",
  ],
};

const seasonalFeatured = seasonTag
  ? seasonalSlugs[seasonTag].map(withThumb).filter((post) => post != null)
  : [];

const evergreenSlugs = [
  "how-to-crochet-a-beginner-scarf",
  "crochet-mug-cozy-for-beginners",
  "how-to-crochet-a-book-sleeve",
  "how-to-crochet-an-earbud-pouch",
  "how-to-crochet-a-wine-bottle-bag",
  "how-to-crochet-a-simple-flower",
];
const evergreenFeatured = evergreenSlugs
  .map(withThumb)
  .filter((post) => post != null);

const featured = [...seasonalFeatured, ...evergreenFeatured]
  .filter(
    (post, index, list) => list.findIndex((p) => p.id === post.id) === index,
  )
  .slice(0, 6);

const featuredHeading =
  seasonalFeatured.length > 0 && seasonTag === "halloween"
    ? "Halloween projects to make"
    : seasonalFeatured.length > 0 && seasonTag === "christmas"
      ? "Christmas projects to make"
      : "Projects worth making";

/**
 * Newest six — but never repeat a card that is already in the featured grid,
 * so the two sections stay distinct. With 69 articles there is always a next
 * newest to promote in its place.
 */
const featuredIds = new Set(featured.map((post) => post.id));
const latest = posts
  .filter((post) => !featuredIds.has(post.id))
  .slice(0, 6);

/** Interactive helpers plus the printable reference charts, in one place. */
const tools = [
  {
    href: "/crochet-gauge-calculator/",
    label: "Gauge calculator",
    blurb: "Compare your swatch with the pattern and see the predicted width.",
  },
  {
    href: "/crochet-stitch-counter/",
    label: "Stitch counter",
    blurb: "Tap to add, subtract, or reset. The count stays in your browser.",
  },
  {
    href: "/crochet-pattern-practice/",
    label: "Pattern practice",
    blurb: "Five quick questions on US abbreviations, repeats, and counts.",
  },
  {
    href: "/charts/",
    label: "Reference charts",
    blurb: "Printable abbreviations, hook-size, and yarn-weight tables.",
  },
];
---

<BaseLayout
  title="Crochet Explained: Beginner Crochet Tutorials, Charts & Free Patterns"
  description={SITE.description}
>
  {/* Hero */}
  <section class="border-b border-rule bg-paper-deep">
    <div class="mx-auto max-w-5xl px-6 py-14 sm:px-8 sm:py-20">
      <p class="text-xs font-semibold tracking-wider text-terracotta-deep uppercase">
        {SITE.name}
      </p>
      <h1 class="mt-3 max-w-2xl font-serif text-4xl leading-tight tracking-tight sm:text-5xl">
        Clear crochet tutorials, charts, and free patterns
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-soft">
        Learn the stitches, keep the reference charts close, and follow
        step-by-step project guides written in plain US crochet terms. No fluff,
        no guesswork.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/free-patterns/"
          class="rounded-full bg-terracotta px-6 py-2.5 font-medium text-paper no-underline transition-colors hover:bg-terracotta-deep"
        >
          Explore patterns
        </a>
        <a
          href="/start-here/"
          class="rounded-full border border-rule bg-paper px-6 py-2.5 font-medium text-ink-soft no-underline transition-colors hover:border-terracotta hover:text-terracotta-deep"
        >
          Start learning
        </a>
      </div>
    </div>
  </section>

  <ResumeCard />

  {/* Featured projects */}
  {
    featured.length > 0 && (
      <section class="border-b border-rule">
        <div class="mx-auto max-w-5xl px-6 py-12 sm:px-8 sm:py-16">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 class="font-serif text-2xl tracking-tight sm:text-3xl">
              {featuredHeading}
            </h2>
            <a
              href="/free-patterns/"
              class="text-sm text-terracotta-deep no-underline hover:underline"
            >
              All free patterns
            </a>
          </div>
          <p class="mt-2 max-w-2xl leading-relaxed text-ink-soft">
            Approachable projects with step-by-step diagrams for the parts
            beginners get stuck on.
          </p>
          <div class="mt-8 grid grid-cols-2 gap-x-4 gap-y-7 sm:grid-cols-3 sm:gap-x-6 sm:gap-y-9">
            {featured.map((post, index) => (
              <PostCard post={post} compact eager={index < 3} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {/* Start Here — the guided course, introduced once */}
  {
    stages.length > 0 && (
      <section class="border-b border-rule bg-paper-deep">
        <div class="mx-auto max-w-5xl px-6 py-12 sm:px-8 sm:py-16">
          <div class="grid gap-8 sm:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] sm:items-start sm:gap-12">
            <div>
              <p class="text-xs font-semibold tracking-wider text-terracotta-deep uppercase">
                Start here
              </p>
              <h2 class="mt-2 font-serif text-2xl tracking-tight sm:text-3xl">
                A free {totalSteps}-step beginner course
              </h2>
              <p class="mt-3 leading-relaxed text-ink-soft">
                The same material most sites scatter, arranged as a route. Begin
                at step one and follow the link at the bottom of each page.
                Nothing is locked, and nothing needs an email address.
              </p>
              <a
                href="/start-here/"
                class="mt-6 inline-block rounded-full bg-terracotta px-6 py-2.5 font-medium text-paper no-underline transition-colors hover:bg-terracotta-deep"
              >
                See the {totalSteps}-step course
              </a>
            </div>
            <ol class="divide-y divide-rule border-y border-rule">
              {stages.map((stage, index) => (
                <li>
                  <a
                    href={`/${stage.steps[0].post.id}/`}
                    class="group flex items-baseline gap-4 py-3.5 no-underline"
                  >
                    <span
                      class="font-serif text-sm text-ink-faint"
                      aria-hidden="true"
                    >
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <span class="min-w-0 flex-1 font-medium text-ink group-hover:text-terracotta-deep">
                      {stage.stage}
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>
    )
  }

  {/* Browse by topic */}
  <section class="border-b border-rule">
    <div class="mx-auto max-w-5xl px-6 py-12 sm:px-8 sm:py-16">
      <h2 class="font-serif text-2xl tracking-tight sm:text-3xl">
        Browse by topic
      </h2>
      <div class="mt-6 grid gap-3 sm:grid-cols-2">
        {
          Object.values(CATEGORIES).map((category) => (
            <a
              href={`/${category.slug}/`}
              class="rounded-lg border border-rule bg-paper px-5 py-4 no-underline transition-colors hover:border-terracotta"
            >
              <span class="block font-medium text-ink">{category.label}</span>
              <span class="mt-1 block text-sm leading-relaxed text-ink-soft">
                {category.blurb}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* Tools & charts */}
  <section class="border-b border-rule bg-paper-deep">
    <div class="mx-auto max-w-5xl px-6 py-12 sm:px-8 sm:py-16">
      <h2 class="font-serif text-2xl tracking-tight sm:text-3xl">
        Crochet tools and charts
      </h2>
      <p class="mt-2 max-w-2xl leading-relaxed text-ink-soft">
        Open one when you need a number mid-project, not an essay.
      </p>
      <div class="mt-6 grid gap-3 sm:grid-cols-2">
        {
          tools.map((tool) => (
            <a
              href={tool.href}
              class="rounded-lg border border-rule bg-paper px-5 py-4 no-underline transition-colors hover:border-terracotta"
            >
              <span class="block font-medium text-terracotta-deep">
                {tool.label}
              </span>
              <span class="mt-1 block text-sm leading-relaxed text-ink-soft">
                {tool.blurb}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* Latest articles — newest six, no archive pager */}
  {
    latest.length > 0 && (
      <section class="border-b border-rule">
        <div class="mx-auto max-w-5xl px-6 py-12 sm:px-8 sm:py-16">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 class="font-serif text-2xl tracking-tight sm:text-3xl">
              Latest from the blog
            </h2>
            <a
              href="/articles/"
              class="text-sm text-terracotta-deep no-underline hover:underline"
            >
              Browse all articles
            </a>
          </div>
          <div class="mt-8 grid grid-cols-2 gap-x-4 gap-y-7 sm:grid-cols-3 sm:gap-x-6 sm:gap-y-9">
            {latest.map((post) => (
              <PostCard post={post} compact />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <div class="mx-auto max-w-5xl px-6 py-12 sm:px-8">
    <AdSlot placement="footer" />
  </div>
</BaseLayout>
