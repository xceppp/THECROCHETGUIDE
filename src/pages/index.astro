---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import AdSlot from "../components/AdSlot.astro";
import WelcomeBanner from "../components/WelcomeBanner.astro";
import ResumeCard from "../components/ResumeCard.astro";
import { getPathStages } from "../lib/learningPath";
import { SITE, CATEGORIES } from "../config";
import { isHalloweenThemeActive } from "../lib/seasonalTheme";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const halloween = isHalloweenThemeActive();
const halloweenPosts = posts.filter((post) =>
  post.data.tags.some((tag) => tag.toLowerCase() === "halloween"),
);

const [lead, ...rest] = posts;
const recent = rest.slice(0, 6);

const stages = await getPathStages();
const totalSteps = stages.reduce((sum, stage) => sum + stage.steps.length, 0);
const firstStep = stages[0]?.steps[0]?.post;
---

<BaseLayout title={SITE.name} description={SITE.description}>
  <WelcomeBanner
    firstStepSlug={firstStep?.id}
    totalSteps={totalSteps}
    halloween={halloween}
  />

  <ResumeCard />

  <hr class="halloween-divider mx-auto max-w-4xl" aria-hidden="true" />

  {
    halloween && halloweenPosts.length > 0 && (
      <section class="border-b border-rule">
        <div class="mx-auto max-w-4xl px-6 py-12 sm:px-8">
          <h2 class="font-serif text-2xl tracking-tight">
            Halloween projects
          </h2>
          <p class="mt-2 leading-relaxed text-ink-soft">
            Seasonal tutorials tagged Halloween. Same plain-English voice as the
            rest of the guide — no fluff, no mystery abbreviations.
          </p>
          <div class="mt-6 space-y-8 divide-y divide-rule [&>*:not(:first-child)]:pt-8">
            {halloweenPosts.slice(0, 5).map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <hr class="halloween-divider mx-auto max-w-4xl" aria-hidden="true" />

  {
    stages.length > 0 && (
      <section class="border-b border-rule">
        <div class="mx-auto max-w-4xl px-6 sm:px-8 py-12">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 class="font-serif text-2xl tracking-tight">
              The course, start to finish
            </h2>
            <a
              href="/start-here"
              class="text-sm text-terracotta-deep no-underline hover:underline"
            >
              See all {totalSteps} steps
            </a>
          </div>
          <p class="mt-2 leading-relaxed text-ink-soft">
            Six stages, in teaching order. Each page ends with a link to the next
            one, so you never have to work out what to read after this.
          </p>

          <ol class="mt-6 divide-y divide-rule border-y border-rule">
            {stages.map((stage, index) => (
              <li>
                <a
                  href={`/${stage.steps[0].post.id}`}
                  class="group flex items-baseline gap-4 py-3.5 no-underline"
                >
                  <span
                    class="font-serif text-sm text-ink-faint"
                    aria-hidden="true"
                  >
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="font-medium text-ink group-hover:text-terracotta-deep">
                      {stage.stage}
                    </span>
                  </span>
                  <span class="shrink-0 text-xs text-ink-faint">
                    {`${stage.steps.length} ${stage.steps.length === 1 ? "step" : "steps"}`}
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  <hr class="halloween-divider mx-auto max-w-4xl" aria-hidden="true" />

  <div class="mx-auto max-w-4xl px-6 sm:px-8 py-12">
    <div class="mb-12 flex flex-wrap gap-x-3 gap-y-2 text-sm">
      {
        Object.values(CATEGORIES).map((category) => (
          <a
            href={`/${category.slug}`}
            class="rounded-full border border-rule bg-paper px-4 py-1.5 text-ink-soft no-underline transition-colors hover:border-terracotta hover:text-terracotta-deep"
          >
            {category.label}
          </a>
        ))
      }
    </div>

    {
      posts.length === 0 ? (
        <p class="rounded-lg border border-rule bg-paper-deep px-5 py-6 text-ink-soft">
          The first articles are being written. Check back shortly.
        </p>
      ) : (
        <>
          <h2 class="text-xs font-semibold tracking-wider text-ink-faint uppercase">
            Start here
          </h2>
          <div class="mt-5">
            <PostCard post={lead} lead />
          </div>

          {recent.length > 0 && (
            <>
              <h2 class="mt-12 text-xs font-semibold tracking-wider text-ink-faint uppercase">
                More from the guide
              </h2>
              <div class="mt-5 space-y-8 divide-y divide-rule [&>*:not(:first-child)]:pt-8">
                {recent.map((post) => (
                  <PostCard post={post} />
                ))}
              </div>
            </>
          )}

          <AdSlot placement="footer" />
        </>
      )
    }
  </div>
</BaseLayout>
