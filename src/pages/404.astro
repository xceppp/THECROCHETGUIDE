---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CATEGORIES } from "../config";
---

<BaseLayout
  title="Page not found"
  description="That page does not exist, but these sections probably have what you were looking for."
  noindex
>
  <div class="mx-auto max-w-2xl px-5 py-20 text-center">
    <p class="font-serif text-5xl text-terracotta">404</p>
    <h1 class="mt-4 font-serif text-2xl tracking-tight sm:text-3xl">
      This page dropped a stitch
    </h1>
    <p class="mx-auto mt-3 max-w-md leading-relaxed text-ink-soft">
      The page you were after is not here. It may have been renamed, or the link
      that sent you may have a typo in it.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-x-4 gap-y-2 text-sm">
      {
        Object.values(CATEGORIES).map((category) => (
          <a
            href={`/${category.slug}`}
            class="rounded-full border border-rule px-4 py-1.5 text-ink-soft no-underline transition-colors hover:border-terracotta hover:text-terracotta-deep"
          >
            {category.label}
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
