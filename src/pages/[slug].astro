---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import AdSlot from "../components/AdSlot.astro";
import VideoEmbed from "../components/VideoEmbed.astro";
import StepNav from "../components/StepNav.astro";
import ArticleProgress from "../components/ArticleProgress.astro";
import { getStepPosition } from "../lib/learningPath";
import { grannyRoundOne, grannyRoundTwo } from "../lib/grannyChart";
import { SITE, CATEGORIES } from "../config";
import StructuredData from "../components/StructuredData.astro";
import StitchChart from "../components/StitchChart.astro";
import StageChecklist from "../components/StageChecklist.astro";
import { Image } from "astro:assets";
import { getPostThumbnail } from "../lib/postThumbnails";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const category = CATEGORIES[post.data.category];
const words = post.body?.split(/\s+/).length ?? 0;
const minutes = post.data.readingTime ?? Math.max(1, Math.round(words / 220));

/** Frontmatter dates are calendar days parsed as UTC midnight. */
const dateFormat = {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
} as const;
const published = post.data.pubDate.toLocaleDateString("en-US", dateFormat);
const updated =
  post.data.updatedDate &&
  post.data.updatedDate.toISOString().slice(0, 10) !==
    post.data.pubDate.toISOString().slice(0, 10)
    ? post.data.updatedDate.toLocaleDateString("en-US", dateFormat)
    : "";

/** Only h2s — a table of contents that lists every h3 is noise. */
const toc = headings.filter((heading) => heading.depth === 2);

/**
 * Project stages for the progress checklist: step headings only, never
 * materials, mistakes, or FAQ. Fewer than three is not worth a checklist.
 */
const STAGE =
  /^(step|stage|part|round|rounds|row|rows|panel)\b|^\d+\.\s|\b(assembly|assemble|join|joining|seam|edging|finish|finishing|attach)\b/i;
const NOT_STAGE = /frequently|mistake|troubleshoot|material|what you need|abbreviation|gauge|care\b|at a glance/i;
const stageHeadings = post.data.howTo
  ? headings.filter(
      (heading) =>
        (heading.depth === 2 || heading.depth === 3) &&
        STAGE.test(heading.text.replace(/`/g, "")) &&
        !NOT_STAGE.test(heading.text),
    )
  : [];
const stages = stageHeadings.length >= 3 ? stageHeadings : [];

/** Null when the article sits outside the guided course. */
const step = await getStepPosition(post.id);

const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const related = allPosts
  .filter((entry) => entry.id !== post.id)
  .sort((a, b) => {
    const sameCategory = (entry: CollectionEntry<"posts">) =>
      entry.data.category === post.data.category ? 0 : 1;
    return (
      sameCategory(a) - sameCategory(b) ||
      b.data.pubDate.getTime() - a.data.pubDate.getTime()
    );
  })
  .slice(0, 3);

const socialImage = new URL(
  post.data.ogImage ?? `/social/${post.id}-og.jpg`,
  SITE.url,
).href;
const pinSrc = post.data.pinImage ?? `/social/${post.id}-pin.jpg`;
const pinDescription = `${post.data.pinTitle ?? post.data.title} | ${post.data.description}`;

const patternHeading = toc.find((heading) =>
  /pattern|classic|step 1|body/i.test(heading.text),
);
const glance = post.data.glance;
const showGlance =
  Boolean(glance) ||
  (post.data.category === "patterns" && post.data.howTo);
const grannyChart =
  post.id === "halloween-granny-square-variations" ||
  post.id === "christmas-granny-square-variations";
const thumb = getPostThumbnail(post.id);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.pubDate}
  modifiedTime={post.data.updatedDate ?? post.data.pubDate}
  image={socialImage}
>
  {/* Only worth a reading bar when there is enough article to get lost in. */}
  {toc.length > 2 && <ArticleProgress headings={toc} minutes={minutes} />}

  {/* Only course steps carry the slug, so opening a standalone article never
      counts toward progress. */}
  <div class="mx-auto flex max-w-6xl items-start gap-10 px-5 py-10 sm:px-8 sm:py-14">
  <article
    class="min-w-0 max-w-[740px] flex-1"
    data-article-slug={post.id}
    data-course-slug={step ? post.id : undefined}
  >
    <nav aria-label="Breadcrumb" class="no-print text-xs text-ink-faint">
      <a href="/" class="no-underline hover:text-terracotta-deep">Home</a>
      <span aria-hidden="true" class="mx-1.5">/</span>
      <a
        href={`/${category.slug}/`}
        class="no-underline hover:text-terracotta-deep">{category.label}</a
      >
    </nav>

    {
      step && (
        <a
          href="/start-here/"
          class="no-print mt-4 inline-flex items-center gap-2 rounded-full border border-rule bg-paper-deep px-3 py-1 text-xs no-underline transition-colors hover:border-terracotta"
        >
          <span class="font-semibold text-terracotta-deep">
            Step {step.number} of {step.total}
          </span>
          <span class="text-ink-faint">{step.stage}</span>
        </a>
      )
    }

    <StructuredData post={post} image={socialImage} />

    {
      <img
        src={pinSrc}
        alt=""
        width="1000"
        height="1500"
        class="pin-source"
        data-pin-description={pinDescription}
      />
    }

    <header class="mt-4">
      <h1 class="article-title">
        {post.data.title}
      </h1>
      {
        post.data.quickAnswer && (
          <p class="article-dek quick-answer text-ink">
            {post.data.quickAnswer}
          </p>
        )
      }
      <p class="article-dek text-ink-soft">
        {post.data.description}
      </p>

      <div
        class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 border-y border-rule py-3 text-xs text-ink-faint"
      >
        <span>
          Published by <a href={SITE.author.url} class="text-ink-soft underline hover:text-terracotta-deep">{SITE.author.name}</a>
        </span>
        <span aria-hidden="true">&middot;</span>
        <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{published}</time>
        {
          updated && post.data.updatedDate && (
            <>
              <span aria-hidden="true">&middot;</span>
              <span>
                Updated <time datetime={post.data.updatedDate.toISOString().slice(0, 10)}>{updated}</time>
              </span>
            </>
          )
        }
        <span aria-hidden="true">&middot;</span>
        <span>{minutes} min read</span>
        {
          post.data.level && (
            <>
              <span aria-hidden="true">&middot;</span>
              <span class="capitalize">{post.data.level}</span>
            </>
          )
        }
        {
          post.data.printable && (
            <button
              type="button"
              data-print
              class="no-print ml-auto min-h-11 rounded border border-rule px-3 py-2 text-xs text-ink-soft transition-colors hover:border-terracotta hover:text-terracotta-deep"
            >
              Print this page
            </button>
          )
        }
      </div>
    </header>

    {
      thumb && (
        <Image
          src={thumb}
          alt={post.data.title}
          widths={[480, 720, 960]}
          sizes="(min-width: 720px) 720px, 100vw"
          class="no-print mt-6 aspect-[3/2] w-full rounded-lg border border-rule object-cover"
          loading="eager"
        />
      )
    }

    {
      post.data.videoUrl && (
        <VideoEmbed url={post.data.videoUrl} title={post.data.title} />
      )
    }

    {
      showGlance && (
        <section class="no-print mt-6 rounded-lg border border-rule bg-paper-deep px-5 py-4">
          <h2 class="text-xs font-semibold tracking-wider text-ink-faint uppercase">
            At a glance
          </h2>
          <dl class="mt-3 grid gap-2 text-sm sm:grid-cols-2">
            <div>
              <dt class="text-ink-faint">Skill level</dt>
              <dd class="capitalize">{post.data.level ?? "See the pattern"}</dd>
            </div>
            <div>
              <dt class="text-ink-faint">Time</dt>
              <dd>{glance?.time ?? "See the pattern"}</dd>
            </div>
            <div>
              <dt class="text-ink-faint">Finished size</dt>
              <dd>{glance?.size ?? "Estimated in the pattern"}</dd>
            </div>
            <div>
              <dt class="text-ink-faint">Yarn weight</dt>
              <dd>{glance?.yarn ?? "See the pattern"}</dd>
            </div>
            <div>
              <dt class="text-ink-faint">Hook size</dt>
              <dd>{glance?.hook ?? "See the pattern"}</dd>
            </div>
            <div>
              <dt class="text-ink-faint">Yardage</dt>
              <dd>{glance?.yardage ?? "Estimated in the pattern"}</dd>
            </div>
          </dl>
          {
            patternHeading && (
              <a
                href={`#${patternHeading.slug}`}
                class="mt-4 inline-flex min-h-11 items-center text-sm text-terracotta-deep no-underline hover:underline"
              >
                Jump to pattern
              </a>
            )
          }
        </section>
      )
    }

    {
      toc.length > 2 && (
        <details
          class="no-print mt-8 rounded-lg border border-rule bg-paper-deep px-5 py-3 lg:hidden"
        >
          <summary class="min-h-11 cursor-pointer text-xs font-semibold tracking-wider text-ink-faint uppercase">
            On this page
          </summary>
          <ol class="mt-2 space-y-1 text-sm">
            {toc.map((heading) => (
              <li>
                <a
                  href={`#${heading.slug}`}
                  class="inline-flex min-h-11 items-center text-ink-soft no-underline hover:text-terracotta-deep hover:underline"
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ol>
        </details>
      )
    }

    {stages.length > 0 && <StageChecklist slug={post.id} stages={stages} />}

    {
      post.data.category === "patterns" && post.data.howTo && (
        <p class="mt-8 text-sm leading-relaxed text-ink-soft">
          US crochet terms throughout. Sizes here are worked out from gauge
          rather than from a finished sample, so swatch and measure as you go,
          and the pictures of finished pieces are illustrations. Made one? Send
          a photo through the <a href="/contact/">contact page</a>.
        </p>
      )
    }

    {
      grannyChart && (
        <StitchChart
          title="Classic granny, rounds 1 and 2"
          rounds={[
            {
              ...grannyRoundOne,
              stitches: [...grannyRoundOne.stitches],
              color: "#b0604a",
            },
            {
              ...grannyRoundTwo,
              stitches: [...grannyRoundTwo.stitches],
              color: "#2f2a26",
            },
          ]}
        />
      )
    }

    <div class="prose mt-10 max-w-[740px]">
      <Content />
    </div>

    <AdSlot placement="inArticle" />

    {
      post.data.tags.length > 0 && (
        <ul class="no-print mt-10 flex flex-wrap gap-2 border-t border-rule pt-6">
          {post.data.tags.map((tag) => (
            <li class="rounded-full border border-rule px-2.5 py-0.5 text-xs text-ink-soft">
              {tag}
            </li>
          ))}
        </ul>
      )
    }

    {/* Inside the course, the next step is the single clear action. Outside it,
        fall back to a related-articles list. */}
    {step && <StepNav position={step} />}

    <aside class="author-box mt-12 border-t border-rule pt-6">
      <p class="font-serif text-lg">
        <a href={SITE.author.url} class="no-underline hover:text-terracotta-deep">{SITE.author.name}</a>
        <span class="ml-1 text-sm text-ink-faint">{SITE.author.role}</span>
      </p>
      <p class="mt-1 max-w-xl text-sm leading-relaxed text-ink-soft">
        {SITE.author.bio}
      </p>
      <p class="mt-3 text-sm">
        <a href={SITE.author.url} class="text-terracotta-deep underline">How pages are checked</a>
        <span aria-hidden="true"> · </span>
        <a href="/contact/" class="text-terracotta-deep underline">
          Found an error? Report it
        </a>
      </p>
    </aside>

    {
      related.length > 0 && (
        <section class="no-print mt-14 border-t border-rule pt-8">
          <h2 class="font-serif text-xl tracking-tight">Read this next</h2>
          <ul class="mt-4 divide-y divide-rule">
            {related.map((entry) => (
              <li class="py-3">
                <a
                  href={`/${entry.id}/`}
                  class="group block no-underline"
                >
                  <span class="font-medium text-ink group-hover:text-terracotta-deep">
                    {entry.data.title}
                  </span>
                  <span class="mt-0.5 block text-sm text-ink-soft">
                    {entry.data.description}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
  {
    toc.length > 2 && (
      <nav
        aria-label="On this page"
        class="no-print sticky top-8 hidden w-56 shrink-0 lg:block"
      >
        <h2 class="text-xs font-semibold tracking-wider text-ink-faint uppercase">
          On this page
        </h2>
        <ol class="mt-3 space-y-2 text-sm">
          {toc.map((heading) => (
            <li>
              <a
                href={`#${heading.slug}`}
                class="text-ink-soft no-underline hover:text-terracotta-deep hover:underline"
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )
  }
  </div>
</BaseLayout>

<script>
  import { recordArticleOpen } from "../scripts/articleReads";
  import { markRead } from "../scripts/progress";

  document
    .querySelector<HTMLButtonElement>("[data-print]")
    ?.addEventListener("click", () => window.print());

  const article = document.querySelector<HTMLElement>("[data-article-slug]");
  if (article?.dataset.articleSlug) recordArticleOpen(article.dataset.articleSlug);
  if (article?.dataset.courseSlug) markRead(article.dataset.courseSlug);

  /**
   * Charts wider than the screen scroll sideways. Flag the ones that actually
   * overflow so the CSS can fade their right edge, and clear the flag once the
   * reader reaches the last column. Also give overflowing charts a tab stop —
   * a scrollable region is unreachable by keyboard without one.
   */
  for (const wrapper of document.querySelectorAll<HTMLElement>(".table-scroll")) {
    const table = wrapper.querySelector("table");
    if (!table) continue;

    const sync = () => {
      const overflows = table.scrollWidth - table.clientWidth > 1;
      const atEnd =
        table.scrollLeft + table.clientWidth >= table.scrollWidth - 1;

      wrapper.toggleAttribute("data-scrollable", overflows);
      wrapper.toggleAttribute("data-scroll-end", overflows && atEnd);

      if (overflows) table.setAttribute("tabindex", "0");
      else table.removeAttribute("tabindex");
    };

    sync();
    table.addEventListener("scroll", sync, { passive: true });
    new ResizeObserver(sync).observe(table);
  }
</script>
