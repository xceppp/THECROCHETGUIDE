---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config";

const effective = "October 7, 2026";
---

<BaseLayout
  title="Privacy & Cookies (United States)"
  description={`How ${SITE.name} handles data and cookies for US visitors, including California CCPA/CPRA rights.`}
>
  <div class="mx-auto max-w-3xl px-6 sm:px-8 py-10 sm:py-14">
    <h1 class="font-serif text-3xl tracking-tight sm:text-4xl">
      Privacy &amp; Cookies (United States)
    </h1>
    <p class="mt-3 text-sm text-ink-faint">Last updated {effective}</p>

    <div class="prose mt-8">
      <p>
        This notice is for visitors in the United States. If you are in the EEA,
        UK, or Switzerland, see the
        <a href="/privacy-eu/">EU / UK privacy notice</a> instead. The overview hub
        is the <a href="/privacy-policy/">privacy policy</a>.
      </p>

      <h2>Who we are</h2>
      <p>
        {SITE.name} publishes this site at {SITE.url}. The editorial identity is
        the {SITE.author.name}. Privacy
        requests go through the <a href="/contact/">contact page</a>.
      </p>

      <h2>Information we collect</h2>
      <ul>
        <li>
          Automatic technical data when you load pages (IP address, device and
          browser type, pages viewed, referrer), used to run and improve the site.
        </li>
        <li>
          Analytics data via Google Analytics when you allow it.
        </li>
        <li>
          Advertising cookies via Google AdSense when ads are allowed, which may
          support personalized or non-personalized ads depending on your choice.
        </li>
        <li>
          Email content if you write to us — kept only to reply and maintain the
          site.
        </li>
        <li>
          Course progress stored only in your browser (local storage), not as an
          account on our servers.
        </li>
      </ul>

      <h2>Cookies</h2>
      <p>
        Cookies help the host serve pages, remember your cookie choice, measure
        traffic, and show ads. You can accept, reject non-essential cookies, or
        choose <strong>Do not sell or share</strong> to turn off personalized
        advertising while still allowing non-personalized ads.
      </p>
      <table>
        <thead>
          <tr>
            <th>Category</th>
            <th>Purpose</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Essential</td>
            <td>Site delivery, security, storing your cookie preference</td>
          </tr>
          <tr>
            <td>Analytics</td>
            <td>Google Analytics — aggregate traffic</td>
          </tr>
          <tr>
            <td>Advertising</td>
            <td>Google AdSense and partners — ads and measurement</td>
          </tr>
        </tbody>
      </table>
      <p>
        Change your choice:
        <a href="/cookie-settings/">cookie settings</a>. You can also use
        <a href="https://www.google.com/settings/ads" rel="nofollow noopener"
          >Google Ads Settings</a
        >
        and
        <a href="https://optout.aboutads.info/" rel="nofollow noopener"
          >aboutads.info</a
        >.
      </p>

      <h2>California (CCPA / CPRA)</h2>
      <p>
        {SITE.name} does not sell personal information for money. We may “share”
        personal information for cross-context behavioral advertising through
        advertising partners unless you opt out.
      </p>
      <p>You may have the right to:</p>
      <ul>
        <li>Know what personal information is collected</li>
        <li>Delete personal information</li>
        <li>Correct inaccurate personal information</li>
        <li>Opt out of sale or sharing</li>
        <li>Non-discrimination for exercising these rights</li>
      </ul>
      <p>
        To opt out of sale/sharing for personalized ads, use
        <strong>Do not sell or share</strong> on the cookie banner or
        <a href="/cookie-settings/">cookie settings</a>. Other requests go to the
        <a href="/contact/">contact page</a>. We will not give you a worse reading
        experience for making a request.
      </p>

      <h2>Children</h2>
      <p>
        This site is not directed at children under 13. We do not knowingly
        collect personal information from children under 13.
      </p>

      <h2>Related</h2>
      <ul>
        <li><a href="/privacy-eu/">EU / UK privacy &amp; cookies</a></li>
        <li><a href="/terms/">Terms of Use</a></li>
        <li><a href="/disclosures/">Disclosures</a></li>
      </ul>
    </div>
  </div>
</BaseLayout>
