---
import { Image } from "astro:assets";
import banner from "../assets/banner.png";
import { SITE } from "../config";

interface Props {
  /** First step of the course, so the primary button goes somewhere useful. */
  firstStepSlug?: string;
  totalSteps: number;
}

const { firstStepSlug, totalSteps } = Astro.props;
---

<section class="no-print relative overflow-hidden border-b border-rule bg-paper-deep">
  {/* Chain-stitch motif drawn in SVG rather than loaded as an image: it matches
      the palette, scales to any screen, and costs no network request. */}
  <svg
    class="pointer-events-none absolute inset-0 h-full w-full"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <pattern
        id="chain-stitch"
        width="56"
        height="32"
        patternUnits="userSpaceOnUse"
        patternTransform="rotate(-8)"
      >
        <path
          d="M0 16 C 8 2, 20 2, 28 16 C 36 30, 48 30, 56 16"
          fill="none"
          stroke="var(--color-terracotta)"
          stroke-width="1.6"
          stroke-linecap="round"
          opacity="0.16"
        />
        <path
          d="M0 16 C 8 30, 20 30, 28 16 C 36 2, 48 2, 56 16"
          fill="none"
          stroke="var(--color-sage)"
          stroke-width="1.6"
          stroke-linecap="round"
          opacity="0.13"
        />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#chain-stitch)" />
  </svg>

  <div class="relative mx-auto max-w-2xl px-5 pt-10 sm:pt-14">
    {/* The wide artwork puts its wordmark in the centre, so on a phone the
        frame is squarer and object-cover crops the empty sides away rather
        than shrinking the whole thing into an illegible strip.
        Eager and high priority because this is the homepage LCP element. */}
    <Image
      src={banner}
      alt={`${SITE.name} — better stitches, a happier you`}
      widths={[640, 1024]}
      sizes="(min-width: 672px) 672px, 100vw"
      loading="eager"
      fetchpriority="high"
      class="aspect-[16/9] w-full rounded-xl border border-rule object-cover sm:aspect-[8/3]"
    />
  </div>

  <div class="relative mx-auto max-w-2xl px-5 pt-10 pb-16 sm:pb-20">
    <p class="text-xs font-semibold tracking-wider text-terracotta-deep uppercase">
      Welcome
    </p>

    <h1 class="mt-3 font-serif text-3xl leading-tight tracking-tight sm:text-[2.6rem]">
      Crochet answers without the guesswork
    </h1>

    <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-soft">
      Most crochet instructions explain everything except the part you are stuck
      on. This site does the opposite: plain-English tutorials, printable
      charts, and honest answers about hooks and yarn — arranged in the order
      you actually need them.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      {
        firstStepSlug && (
          <a
            href="/start-here"
            class="rounded-full bg-terracotta px-6 py-2.5 font-medium text-paper no-underline transition-colors hover:bg-terracotta-deep"
          >
            Start the {totalSteps}-step course
          </a>
        )
      }
      <a
        href="/charts"
        class="rounded-full border border-rule bg-paper px-6 py-2.5 font-medium text-ink-soft no-underline transition-colors hover:border-terracotta hover:text-terracotta-deep"
      >
        Jump to the charts
      </a>
    </div>

    <ul
      class="mt-8 flex flex-wrap gap-x-5 gap-y-1.5 text-sm text-ink-faint"
      aria-label={`Why use ${SITE.name}`}
    >
      <li>Free, always</li>
      <li aria-hidden="true">&middot;</li>
      <li>No email required</li>
      <li aria-hidden="true">&middot;</li>
      <li>US terms, with UK conversions</li>
      <li aria-hidden="true">&middot;</li>
      <li>Printable</li>
    </ul>
  </div>
</section>
