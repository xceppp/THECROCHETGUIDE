---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "./PostCard.astro";
import AdSlot from "./AdSlot.astro";
import { CATEGORIES, type CategoryId } from "../config";

interface Props {
  category: CategoryId;
}

const { category } = Astro.props;
const meta = CATEGORIES[category];

const posts = (
  await getCollection("posts", ({ data }) => !data.draft && data.category === category)
).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout title={meta.label} description={meta.blurb}>
  <div class="mx-auto max-w-2xl px-5 py-10 sm:py-14">
    <h1 class="font-serif text-3xl tracking-tight sm:text-4xl">{meta.label}</h1>
    <p class="mt-3 text-lg leading-relaxed text-ink-soft">{meta.blurb}</p>

    {
      posts.length > 0 ? (
        <>
          <div class="mt-10 space-y-9 divide-y divide-rule [&>*:not(:first-child)]:pt-9">
            {posts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
          <AdSlot placement="footer" />
        </>
      ) : (
        <p class="mt-10 rounded-lg border border-rule bg-paper-deep px-5 py-6 text-ink-soft">
          The first {meta.label.toLowerCase()} pages are being written right now.
          In the meantime, the{" "}
          <a href="/charts" class="text-terracotta-deep underline">
            charts and tools
          </a>{" "}
          section has the quick answers most people are looking for.
        </p>
      )
    }
  </div>
</BaseLayout>
