---
import { Image } from "astro:assets";
import mark from "../assets/mark.png";
import { SITE, NAV } from "../config";

const path = Astro.url.pathname;
const isActive = (href: string) =>
  path === href || path.startsWith(`${href}/`);
---

<header class="no-print border-b border-rule bg-paper">
  <div class="mx-auto flex max-w-5xl flex-col gap-3 px-6 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-8">
    <a href="/" class="group flex items-center gap-2.5 no-underline">
      {/* Empty alt on purpose: the site name sits right beside it, and a
          screen reader announcing the brand twice is noise. */}
      <Image src={mark} alt="" height={32} loading="eager" class="h-8 w-auto" />
      <span class="font-serif text-xl tracking-tight text-ink group-hover:text-terracotta-deep">
        {SITE.name}
      </span>
    </a>

    <nav aria-label="Main">
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "no-underline transition-colors hover:text-terracotta-deep",
                  isActive(item.href)
                    ? "text-terracotta-deep underline decoration-1 underline-offset-4"
                    : "text-ink-soft",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
