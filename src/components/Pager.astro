---
import { articlePageHref } from "../lib/articlePages";

interface Props {
  current: number;
  last: number;
}

const { current, last } = Astro.props;
const pages = Array.from({ length: last }, (_, index) => index + 1);
---

{
  last > 1 && (
    <nav
      class="mt-4 flex flex-wrap items-baseline justify-center gap-x-4 gap-y-2 text-sm"
      aria-label="Article pages"
    >
      {current > 1 ? (
        <a href={articlePageHref(current - 1)} class="text-ink-soft no-underline">
          Previous
        </a>
      ) : (
        <span class="text-ink-faint">Previous</span>
      )}
      {pages.map((page) => (
        <a
          href={articlePageHref(page)}
          aria-current={page === current ? "page" : undefined}
          class:list={[
            "no-underline",
            page === current
              ? "font-medium text-ink underline decoration-terracotta underline-offset-4"
              : "text-ink-soft",
          ]}
        >
          {page}
        </a>
      ))}
      {current < last ? (
        <a href={articlePageHref(current + 1)} class="text-ink-soft no-underline">
          Next
        </a>
      ) : (
        <span class="text-ink-faint">Next</span>
      )}
    </nav>
  )
}
