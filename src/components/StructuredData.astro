---
import type { CollectionEntry } from "astro:content";
import { CATEGORIES, SITE, SOCIALS } from "../config";
import { extractFaqItems, extractHowToSteps, faqPageSchema } from "../lib/seo";

interface Props {
  post: CollectionEntry<"posts">;
  image: string;
}

const { post, image } = Astro.props;
const category = CATEGORIES[post.data.category];
const pageUrl = new URL(`/${post.id}/`, SITE.url).href;
const published = post.data.pubDate.toISOString();
const modified = (post.data.updatedDate ?? post.data.pubDate).toISOString();

const organization = {
  "@type": "Organization",
  name: SITE.name,
  url: SITE.url,
  logo: {
    "@type": "ImageObject",
    url: new URL("/icon-512.png", SITE.url).href,
  },
  ...(SOCIALS.length > 0 && { sameAs: SOCIALS.map((social) => social.url) }),
};

const howToSteps = post.data.howTo ? extractHowToSteps(post.body) : [];
const faqRaw = faqPageSchema(extractFaqItems(post.body));
const faq = faqRaw
  ? (({ "@context": _context, ...rest }) => rest)(faqRaw)
  : null;
const howTo =
  howToSteps.length > 0
    ? {
        "@type": "HowTo",
        name: post.data.title,
        description: post.data.description,
        image,
        inLanguage: "en-US",
        step: howToSteps.map((step, index) => ({
          "@type": "HowToStep",
          position: index + 1,
          name: step.name,
          text: step.text,
          url: `${pageUrl}#step-${index + 1}`,
        })),
      }
    : null;

const graph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      headline: post.data.title,
      description: post.data.description,
      image,
      datePublished: published,
      dateModified: modified,
      inLanguage: "en-US",
      author: {
        "@type": "Person",
        name: SITE.author.name,
        jobTitle: SITE.author.role,
        url: new URL(SITE.author.url, SITE.url).href,
      },
      publisher: organization,
      mainEntityOfPage: pageUrl,
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: new URL("/", SITE.url).href,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: category.label,
          item: new URL(`/${category.slug}/`, SITE.url).href,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: post.data.title,
          item: pageUrl,
        },
      ],
    },
    ...(howTo ? [howTo] : []),
    ...(faq ? [faq] : []),
  ],
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />
