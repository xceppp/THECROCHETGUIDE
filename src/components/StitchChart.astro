---
/**
 * Inline crochet symbol chart. Symbols follow the Craft Yarn Council set:
 * chain = oval, slip stitch = filled dot, sc = x, hdc = T, dc = T with one
 * slash, tr = T with two slashes, magic ring = circle.
 */
export type Stitch = "ch" | "slst" | "sc" | "hdc" | "dc" | "tr" | "mr";

export interface ChartRound {
  label: string;
  stitches: string[];
  color?: string;
}

interface Props {
  title: string;
  type?: "round" | "rows";
  rounds: ChartRound[];
}

const { title, type = "round", rounds } = Astro.props;

function symbol(kind: string, x: number, y: number, scale: number, color: string) {
  const s = scale;
  if (kind === "mr") {
    return `<circle cx="${x}" cy="${y}" r="${10 * s}" fill="none" stroke="${color}" stroke-width="1.5"/>`;
  }
  if (kind === "ch") {
    return `<ellipse cx="${x}" cy="${y}" rx="${7 * s}" ry="${3.6 * s}" fill="none" stroke="${color}" stroke-width="1.4" transform="rotate(-40 ${x} ${y})"/>`;
  }
  if (kind === "slst") {
    return `<circle cx="${x}" cy="${y}" r="${2.4 * s}" fill="${color}"/>`;
  }
  if (kind === "sc") {
    const a = 4.2 * s;
    return `<path d="M${x - a} ${y - a} L${x + a} ${y + a} M${x + a} ${y - a} L${x - a} ${y + a}" fill="none" stroke="${color}" stroke-width="1.4"/>`;
  }
  const stem = kind === "hdc" || kind === "dc" || kind === "tr";
  if (!stem) return "";
  const h = 9 * s;
  const arm = 4 * s;
  let marks = "";
  if (kind === "dc" || kind === "tr") {
    marks += `<path d="M${x - 3 * s} ${y + 1 * s} L${x + 3 * s} ${y - 2 * s}" fill="none" stroke="${color}" stroke-width="1.2"/>`;
  }
  if (kind === "tr") {
    marks += `<path d="M${x - 3 * s} ${y + 3.2 * s} L${x + 3 * s} ${y + 0.2 * s}" fill="none" stroke="${color}" stroke-width="1.2"/>`;
  }
  return `<path d="M${x} ${y + h / 2} L${x} ${y - h / 3} M${x - arm} ${y - h / 3} L${x + arm} ${y - h / 3}" fill="none" stroke="${color}" stroke-width="1.4"/>${marks}`;
}

function roundMarkup(items: ChartRound[]) {
  const cx = 180;
  const cy = 180;
  let body = `<circle cx="${cx}" cy="${cy}" r="18" fill="none" stroke="currentColor" stroke-width="1.5"/>`;
  items.forEach((round, index) => {
    const radius = 52 + index * 48;
    const color = round.color ?? "currentColor";
    const count = Math.max(round.stitches.length, 1);
    round.stitches.forEach((stitch, stitchIndex) => {
      const angle = (Math.PI * 2 * stitchIndex) / count - Math.PI / 2;
      const x = cx + Math.cos(angle) * radius;
      const y = cy + Math.sin(angle) * radius;
      body += symbol(stitch, x, y, 0.72, color);
    });
    const labelAngle = -Math.PI / 2;
    const lx = cx + Math.cos(labelAngle) * (radius + 18);
    const ly = cy + Math.sin(labelAngle) * (radius + 18);
    body += `<text x="${lx}" y="${ly}" font-size="11" fill="currentColor">${round.label}</text>`;
  });
  return body;
}

function rowMarkup(items: ChartRound[]) {
  let body = "";
  const bottom = items.length - 1;
  items.forEach((round, index) => {
    const visualRow = bottom - index;
    const y = 40 + visualRow * 36;
    const color = round.color ?? "currentColor";
    const reversed = visualRow % 2 === 1;
    const stitches = reversed ? [...round.stitches].reverse() : round.stitches;
    body += `<text x="8" y="${y + 4}" font-size="11" fill="currentColor">${round.label}</text>`;
    stitches.forEach((stitch, stitchIndex) => {
      const x = 48 + stitchIndex * 16;
      body += symbol(stitch, x, y, 0.7, color);
    });
  });
  return body;
}

const markup = type === "round" ? roundMarkup(rounds) : rowMarkup(rounds);
const summary = rounds
  .map((round) => `${round.label}: ${round.stitches.join(", ")}`)
  .join(". ");

const legend: { id: Stitch; name: string }[] = [
  { id: "ch", name: "Chain" },
  { id: "slst", name: "Slip stitch" },
  { id: "sc", name: "Single crochet" },
  { id: "hdc", name: "Half double" },
  { id: "dc", name: "Double crochet" },
  { id: "tr", name: "Treble" },
  { id: "mr", name: "Magic ring" },
];
---

<figure class="stitch-chart not-prose my-8">
  <figcaption class="mb-2 font-serif text-lg text-ink">{title}</figcaption>
  <svg viewBox="0 0 360 360" role="img" class="h-auto w-full text-ink print:text-black">
    <title>{title}</title>
    <desc>{summary}</desc>
    <g set:html={markup} />
  </svg>
  <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-ink-soft">
    {
      legend.map((item) => (
        <li class="inline-flex items-center gap-1.5">
          <svg viewBox="0 0 20 20" class="h-4 w-4 text-ink" aria-hidden="true">
            <g
              set:html={symbol(item.id, 10, 10, 0.85, "currentColor")}
            />
          </svg>
          {item.name}
        </li>
      ))
    }
  </ul>
</figure>
