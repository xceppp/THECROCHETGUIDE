---
import type { MarkdownHeading } from "astro";

/**
 * Fixed reading bar for long articles.
 *
 * The table of contents at the top of the page only helps while you can see
 * it. Once a reader is three sections deep, jumping somewhere else means
 * scrolling all the way back up. This keeps the section list one tap away
 * from anywhere in the article, and shows how much reading is left as
 * minutes rather than a percentage, because "4 min left" is a decision a
 * reader can act on and "62%" is not.
 *
 * Rendered hidden. The script reveals it once the reader is past the article
 * header, so it never covers the title.
 */
interface Props {
  headings: MarkdownHeading[];
  minutes: number;
}

const { headings, minutes } = Astro.props;
---

<div
  class="no-print fixed inset-x-0 top-0 z-40 border-b border-rule bg-paper"
  data-reader
  data-minutes={minutes}
  hidden
>
  {/* The rail is the whole-article measure; the fill is how far in you are. */}
  <div class="h-0.5 w-full bg-rule" aria-hidden="true">
    <div class="h-full w-0 bg-terracotta" data-reader-fill></div>
  </div>

  <div class="mx-auto flex max-w-3xl items-center gap-3 px-6 py-2 sm:px-8">
    <span
      class="shrink-0 text-xs font-medium tabular-nums text-terracotta-deep"
      data-reader-left></span>

    {/* Which section you are in. Dropped on narrow screens, where the button
        and the time are the only things that fit. */}
    <span
      class="hidden min-w-0 flex-1 truncate text-xs text-ink-soft sm:block"
      data-reader-section></span>

    <button
      type="button"
      class="ml-auto shrink-0 rounded-full border border-rule px-3 py-1 text-xs text-ink-soft transition-colors hover:border-terracotta hover:text-terracotta-deep sm:ml-0"
      data-reader-toggle
      aria-expanded="false"
      aria-controls="reader-sections"
    >
      Contents
    </button>
  </div>

  <nav
    class="max-h-[60vh] overflow-y-auto border-t border-rule bg-paper-deep"
    id="reader-sections"
    aria-label="Sections of this article"
    data-reader-panel
    hidden
  >
    <ol class="mx-auto max-w-3xl px-6 py-3 text-sm sm:px-8">
      {
        headings.map((heading) => (
          <li>
            <a
              href={`#${heading.slug}`}
              data-reader-item={heading.slug}
              class="block rounded px-2 py-1.5 text-ink-soft no-underline hover:bg-paper hover:text-terracotta-deep data-[current]:font-medium data-[current]:text-terracotta-deep"
            >
              {heading.text}
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
</div>

<script>
  const host = document.querySelector<HTMLElement>("[data-reader]");
  const article = document.querySelector<HTMLElement>("article");

  if (host && article) {
    const fill = host.querySelector<HTMLElement>("[data-reader-fill]")!;
    const left = host.querySelector<HTMLElement>("[data-reader-left]")!;
    const section = host.querySelector<HTMLElement>("[data-reader-section]")!;
    const toggle = host.querySelector<HTMLButtonElement>(
      "[data-reader-toggle]",
    )!;
    const panel = host.querySelector<HTMLElement>("[data-reader-panel]")!;
    const minutes = Number(host.dataset.minutes) || 1;

    const headings = Array.from(
      document.querySelectorAll<HTMLElement>(".prose h2[id]"),
    );

    const closePanel = () => {
      panel.hidden = true;
      toggle.setAttribute("aria-expanded", "false");
    };

    let current = "";

    const update = () => {
      const rect = article.getBoundingClientRect();

      // Progress is measured across the part of the article that can actually
      // scroll past, so reaching the end reads as 100% rather than stopping
      // short by one viewport.
      const scrollable = rect.height - window.innerHeight;
      const ratio =
        scrollable <= 0
          ? 1
          : Math.min(1, Math.max(0, -rect.top / scrollable));

      fill.style.width = `${(ratio * 100).toFixed(1)}%`;
      const remaining = Math.ceil(minutes * (1 - ratio));
      left.textContent = remaining <= 0 ? "Finished" : `${remaining} min left`;

      // Hold the bar back until the title has scrolled away.
      const shouldShow = rect.top < -140;
      if (host.hidden === shouldShow) {
        host.hidden = !shouldShow;
        if (!shouldShow) closePanel();
      }

      // The active section is the last heading to have crossed the bar.
      let active = headings[0];
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top > 88) break;
        active = heading;
      }

      const slug = active?.id ?? "";
      if (slug !== current) {
        current = slug;
        section.textContent = active?.textContent ?? "";
        for (const item of host.querySelectorAll<HTMLElement>(
          "[data-reader-item]",
        )) {
          item.toggleAttribute(
            "data-current",
            item.dataset.readerItem === slug,
          );
        }
      }
    };

    // Scroll fires far more often than the screen repaints, so coalesce.
    let queued = false;
    const schedule = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        update();
      });
    };

    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule);
    update();

    toggle.addEventListener("click", () => {
      const opening = panel.hidden;
      panel.hidden = !opening;
      toggle.setAttribute("aria-expanded", String(opening));
    });

    panel.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) closePanel();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !panel.hidden) {
        closePanel();
        toggle.focus();
      }
    });
  }
</script>
