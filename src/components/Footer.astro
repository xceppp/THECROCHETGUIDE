---
import { SITE, SOCIALS, CATEGORIES } from "../config";

const year = new Date().getFullYear();

const legal = [
  { label: "About", href: "/about" },
  { label: "Contact", href: "/contact" },
  { label: "Privacy Policy", href: "/privacy-policy" },
  { label: "Terms of Use", href: "/terms" },
  { label: "Disclosures", href: "/disclosures" },
];
---

{/* Margins and padding are deliberately smaller on phones. At desktop sizes
    the generous spacing reads as calm; on a 390px screen the same numbers just
    mean a lot of thumb travel past nothing. */}
<footer class="no-print mt-14 border-t border-rule bg-paper-deep sm:mt-20">
  <div class="mx-auto max-w-5xl px-6 py-10 sm:px-8 sm:py-12">
    {/* Two columns on a phone rather than three stacked lists. Short link text
        wastes most of the width in one column and triples the footer height. */}
    <div class="grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-3 sm:gap-10">
      <div class="col-span-2 sm:col-span-1">
        <p class="font-serif text-lg text-ink">{SITE.name}</p>
        <p class="mt-2 max-w-xs text-sm leading-relaxed text-ink-soft">
          {SITE.tagline}. Written and maintained by {SITE.author.name}.
        </p>
      </div>

      <div>
        <h2 class="text-xs font-semibold tracking-wider text-ink-faint uppercase">
          Browse
        </h2>
        <ul class="mt-3 space-y-2.5 text-sm sm:space-y-1.5">
          {
            Object.values(CATEGORIES).map((category) => (
              <li>
                <a
                  href={`/${category.slug}`}
                  class="text-ink-soft no-underline hover:text-terracotta-deep"
                >
                  {category.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="text-xs font-semibold tracking-wider text-ink-faint uppercase">
          Site
        </h2>
        <ul class="mt-3 space-y-2.5 text-sm sm:space-y-1.5">
          {
            legal.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-ink-soft no-underline hover:text-terracotta-deep"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    {/* Socials first on a phone: they are the tappable thing, and the copyright
        line is not worth putting above them. Desktop keeps the usual order. */}
    <div
      class="mt-10 flex flex-col-reverse gap-4 border-t border-rule pt-6 text-sm text-ink-faint sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {SITE.name}. All rights reserved.</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-1">
        {
          SOCIALS.map((social) => (
            <li>
              <a
                href={social.url}
                rel="me noopener"
                class="no-underline hover:text-terracotta-deep"
              >
                {social.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
