---
import { SITE, SOCIALS, CATEGORIES } from "../config";

const year = new Date().getFullYear();

const legal = [
  { label: "About", href: "/about" },
  { label: "Contact", href: "/contact" },
  { label: "Privacy Policy", href: "/privacy-policy" },
  { label: "Terms of Use", href: "/terms" },
  { label: "Disclosures", href: "/disclosures" },
];
---

<footer class="no-print mt-20 border-t border-rule bg-paper-deep">
  <div class="mx-auto max-w-5xl px-5 py-12">
    <div class="grid gap-10 sm:grid-cols-3">
      <div>
        <p class="font-serif text-lg text-ink">{SITE.name}</p>
        <p class="mt-2 max-w-xs text-sm leading-relaxed text-ink-soft">
          {SITE.tagline}. Written and maintained by {SITE.author.name}.
        </p>
      </div>

      <div>
        <h2 class="text-xs font-semibold tracking-wider text-ink-faint uppercase">
          Browse
        </h2>
        <ul class="mt-3 space-y-1.5 text-sm">
          {
            Object.values(CATEGORIES).map((category) => (
              <li>
                <a
                  href={`/${category.slug}`}
                  class="text-ink-soft no-underline hover:text-terracotta-deep"
                >
                  {category.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="text-xs font-semibold tracking-wider text-ink-faint uppercase">
          Site
        </h2>
        <ul class="mt-3 space-y-1.5 text-sm">
          {
            legal.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-ink-soft no-underline hover:text-terracotta-deep"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col gap-4 border-t border-rule pt-6 text-sm text-ink-faint sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {SITE.name}. All rights reserved.</p>
      <ul class="flex flex-wrap gap-x-4 gap-y-1">
        {
          SOCIALS.map((social) => (
            <li>
              <a
                href={social.url}
                rel="me noopener"
                class="no-underline hover:text-terracotta-deep"
              >
                {social.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
