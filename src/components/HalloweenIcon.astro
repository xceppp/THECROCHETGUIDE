---
/**
 * Tiny decorative pumpkin used in nav/footer during the Halloween skin.
 * Fixed 14×14 so it cannot cause layout shift when the theme toggles on.
 */
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<svg
  class={className}
  width="14"
  height="14"
  viewBox="0 0 14 14"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M7 2.2c.35 0 .7.2.9.55.15-.2.4-.35.7-.35.55 0 .9.55.9 1.1 0 .2-.05.4-.15.55 1.1.35 1.85 1.35 1.85 2.55 0 1.7-1.7 3.1-3.8 3.1S3.6 8.3 3.6 6.6c0-1.2.75-2.2 1.85-2.55A1.4 1.4 0 0 1 5.3 3.5c0-.55.35-1.1.9-1.1.3 0 .55.15.7.35.2-.35.55-.55.9-.55Z"
    fill="currentColor"
    opacity="0.9"
  ></path>
  <path
    d="M7 1.4c0 .7-.15 1.35-.4 1.7"
    stroke="currentColor"
    stroke-width="1.1"
    stroke-linecap="round"
  ></path>
</svg>
