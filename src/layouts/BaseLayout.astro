---
import "../styles/global.css";
import {
  SITE,
  SOCIALS,
  PINTEREST_DOMAIN_VERIFY,
  GOOGLE_SITE_VERIFICATION,
} from "../config";
import { getThemeClass, getThemeId } from "../lib/seasonalTheme";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieConsent from "../components/CookieConsent.astro";

interface Props {
  title: string;
  description?: string;
  /** Set on article pages so the canonical and OG type are correct. */
  type?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Extra JSON-LD to inject, already shaped as a schema.org object. */
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
  /** Replaces the default noindex, nofollow pair. Example: "noindex, follow". */
  robots?: string;
  noindex?: boolean;
  /** Absolute URL for og:image and twitter:image. */
  image?: string;
}

const {
  title,
  description = SITE.description,
  type = "website",
  publishedTime,
  modifiedTime,
  schema,
  robots,
  noindex = false,
  image,
} = Astro.props;

/**
 * Always emit the www + trailing-slash form, even if this HTML is somehow
 * served from a no-slash or apex request. Self-referencing the request path
 * is what created duplicate "canonical" targets in Search Console.
 */
function absoluteCanonical(pathname: string): string {
  const clean = pathname.split("?")[0]?.split("#")[0] || "/";
  const withSlash =
    clean === "/" ? "/" : `${clean.replace(/\/+$/, "")}/`;
  return new URL(withSlash, SITE.url).href;
}

const canonical = absoluteCanonical(Astro.url.pathname);
const branded = `${title} | ${SITE.name}`;
const fullTitle =
  title === SITE.name || title.startsWith(`${SITE.name}:`)
    ? title
    : branded.length > 60
      ? title
      : branded;
const robotsContent = robots ?? (noindex ? "noindex, nofollow" : "");

/**
 * Social crawlers need an absolute URL, and Pinterest and Facebook both
 * ignore a relative one silently. Generated from the brand banner by
 * scripts/generate-brand-assets.mjs at the 1200x630 they expect.
 */
const ogImage = image ?? new URL("/og-default.jpg", Astro.site).href;
const isHome = Astro.url.pathname === "/";

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  inLanguage: "en-US",
  /**
   * Tells Google the social accounts and this site are one entity, which is
   * what lets traffic arriving from Pinterest reinforce the site's own
   * search presence rather than counting as unrelated.
   */
  sameAs: SOCIALS.map((social) => social.url),
  publisher: {
    "@type": "Organization",
    name: SITE.name,
    url: SITE.url,
    logo: {
      "@type": "ImageObject",
      url: new URL("/icon-512.png", SITE.url).href,
    },
  },
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  logo: new URL("/icon-512.png", SITE.url).href,
  sameAs: SOCIALS.map((social) => social.url),
  founder: {
    "@type": "Person",
    name: SITE.author.name,
  },
};

const schemas = [
  ...(isHome ? [websiteSchema, organizationSchema] : []),
  ...(schema ? [schema].flat() : []),
];

/** Legal pages stay visually neutral even during the seasonal skin. */
const legalPaths = new Set([
  "/privacy-policy",
  "/privacy-eu",
  "/privacy-us",
  "/cookie-settings",
  "/terms",
  "/disclosures",
]);
const onLegal = legalPaths.has(Astro.url.pathname.replace(/\/$/, "") || "/");
const themeId = onLegal ? "default" : getThemeId();
const themeClass = onLegal ? "" : getThemeClass();
const halloween = themeId === "halloween";
const themeColor =
  themeId === "halloween"
    ? "#d9731f"
    : themeId === "christmas"
      ? "#9a3b3b"
      : themeId === "teachers"
        ? "#6f8f5c"
        : "#fdfaf6";
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Apply theme before paint so the first frame is not a light→dark flash. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("tcg-theme");
          var prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)",
          ).matches;
          var dark =
            stored === "dark" || (stored !== "light" && prefersDark);
          if (dark) document.documentElement.classList.add("dark");
          document.documentElement.dataset.theme = dark ? "dark" : "light";
        } catch (_) {}
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {robotsContent && <meta name="robots" content={robotsContent} />}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name} — ${SITE.tagline}`} />
    {
      publishedTime && (
        <meta
          property="article:published_time"
          content={publishedTime.toISOString()}
        />
      )
    }
    {
      modifiedTime && (
        <meta
          property="article:modified_time"
          content={modifiedTime.toISOString()}
        />
      )
    }
    {
      /* Pinterest builds Article Rich Pins from og:type, og:title,
         og:description and article:author. Without the author tag the
         Rich Pin validator fails. */
      type === "article" && (
        <meta property="article:author" content={SITE.author.name} />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${SITE.name} — ${SITE.tagline}`} />

    {
      PINTEREST_DOMAIN_VERIFY && (
        <meta name="p:domain_verify" content={PINTEREST_DOMAIN_VERIFY} />
      )
    }
    {
      GOOGLE_SITE_VERIFICATION && (
        <meta
          name="google-site-verification"
          content={GOOGLE_SITE_VERIFICATION}
        />
      )
    }

    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.name}
      href={new URL("rss.xml", Astro.site)}
    />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/icon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content={themeColor} />

    {
      schemas.length > 0 && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(schemas.length === 1 ? schemas[0] : schemas)}
        />
      )
    }

    {/* Default denied until CookieConsent grants storage (EU opt-in / US choice). */}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("consent", "default", {
        analytics_storage: "denied",
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        wait_for_update: 500,
      });
    </script>
  </head>
  <body class:list={["flex min-h-screen flex-col", themeClass]}>
    <a
      href="#main"
      class="no-print sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-ink focus:px-3 focus:py-2 focus:text-paper"
    >
      Skip to content
    </a>
    <Header halloween={halloween} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer halloween={halloween} />
    <CookieConsent />
  </body>
</html>
