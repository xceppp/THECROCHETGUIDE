---
import "../styles/global.css";
import { SITE, ADSENSE_CLIENT, PINTEREST_DOMAIN_VERIFY } from "../config";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  /** Set on article pages so the canonical and OG type are correct. */
  type?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Extra JSON-LD to inject, already shaped as a schema.org object. */
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  type = "website",
  publishedTime,
  modifiedTime,
  schema,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;

const organisation = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  publisher: {
    "@type": "Person",
    name: SITE.author.name,
  },
};

const schemas = [organisation, ...(schema ? [schema].flat() : [])];
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    {
      publishedTime && (
        <meta
          property="article:published_time"
          content={publishedTime.toISOString()}
        />
      )
    }
    {
      modifiedTime && (
        <meta
          property="article:modified_time"
          content={modifiedTime.toISOString()}
        />
      )
    }
    {
      /* Pinterest builds Article Rich Pins from og:type, og:title,
         og:description and article:author. Without the author tag the
         Rich Pin validator fails. */
      type === "article" && (
        <meta property="article:author" content={SITE.author.name} />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />

    {
      PINTEREST_DOMAIN_VERIFY && (
        <meta name="p:domain_verify" content={PINTEREST_DOMAIN_VERIFY} />
      )
    }

    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.name}
      href={new URL("rss.xml", Astro.site)}
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#fdfaf6" />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(schemas.length === 1 ? schemas[0] : schemas)}
    />

    {
      /* Only loads once you have an approved publisher ID in src/config.ts. */
      ADSENSE_CLIENT && (
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
          crossorigin="anonymous"
        />
      )
    }
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="no-print sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-ink focus:px-3 focus:py-2 focus:text-paper"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
